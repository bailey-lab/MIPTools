Bootstrap: localimage
From: sif_files/miptools_base_{{ VERSION }}.sif
Stage: final

%labels
    Author Bailey Lab
    Version {{ VERSION }}

%files
    ../programs /opt
    ../bin /opt
    ../src /opt
    ../snakemake /opt
    ../base_resources /opt/resources
    scif_recipes.scif /opt

%post
    cd /opt/resources/user_scripts_and_config
    VERSION={{ VERSION }}
    sed -i 's/^VERSION=.*/VERSION={{ VERSION }}/' run_miptools.sh
    sed -i 's/^VERSION =.*/VERSION = "{{ VERSION }}"/' run_miptools.sh
    mv 'run_miptools.sh' 'run_miptools_{{ VERSION }}.sh'
    mv 'config.toml' config_{{ VERSION }}.toml

    # add executable flag to executables
    chmod -R +xr /usr/bin
    chmod -R +xr /opt/bin

    # install scif recipes
    /opt/.pixi/envs/default/bin/scif install /opt/scif_recipes.scif

%environment
    export PATH=/opt/bin:/opt/.pixi/envs/default/bin:/opt/programs/MIPWrangler/bin:$PATH
    export DEBIAN_FRONTEND=noninteractive
    export LANG=en_US.UTF-8
    export LANGUAGE="en_US.UTF-8"
    export LC_ALL="en_US.UTF-8"
    export PYTHONNOUSERSITE=1
    export VERSION={{ VERSION }}

%runscript
    rsync /opt/resources/user_scripts_and_config/* /opt/user/ --ignore-existing --ignore-missing-args

%help
    singularity run -B $(pwd -P):/opt/user /path/to/your/downloaded/miptools_dev.sif
