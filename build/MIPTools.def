Bootstrap: localimage
From: sif_files/miptools_base_{{ VERSION }}.sif
Stage: final

%labels
    Author Bailey Lab
    Version {{ VERSION }}

%files
    ../programs /opt
    ../bin /opt
    ../src /opt
    ../snakemake /opt
    ../base_resources /opt/resources
    scif_recipes.scif /opt

%post
    cd /opt/resources/user_scripts_and_config
    VERSION={{ VERSION }}
    sed -i '2i export VERSION={{ VERSION }}' run_miptools.sh
    sed -i "1i # The config file is tied to a particular version of miptools, do not edit\nVERSION: '$VERSION'\n\n" config.yaml
    sed -i "4i # path to the sif file used, must match version above\nmiptools_sif: 'miptools_$VERSION.sif'" config.yaml
    mv 'run_miptools.sh' 'run_miptools_{{ VERSION }}.sh'
    mv 'config.yaml' config_{{ VERSION }}.yaml

    # add executable flag to executables
    chmod -R +xr /usr/bin
    chmod -R +xr /opt/bin

    # install scif recipes
    /opt/.pixi/envs/default/bin/scif install /opt/scif_recipes.scif

%environment
    export PATH=/opt/bin:/opt/.pixi/envs/default/bin:/opt/programs/MIPWrangler/bin:$PATH
    export DEBIAN_FRONTEND=noninteractive
    export LANG=en_US.UTF-8
    export LANGUAGE="en_US.UTF-8"
    export LC_ALL="en_US.UTF-8"
    export PYTHONNOUSERSITE=1
    export VERSION={{ VERSION }}

%runscript
    rsync /opt/resources/user_scripts_and_config/* /opt/config/ --ignore-existing --ignore-missing-args

%help
    singularity run -B $(pwd -P):/opt/config /path/to/your/downloaded/miptools_dev.sif
