# ----- Wrangler Stage -----
Bootstrap: docker
From: amd64/ubuntu:22.04
Stage: wrangler
%files
    ../programs /opt
%post
    if [ ! -f /opt/programs/MIPWrangler.tar.xz ]; then
        apt-get update && apt-get install -yq --no-install-recommends \
            git \
            ca-certificates \
            build-essential \
            g++-10 \
            gcc-10 \
            python3-pip \
            cmake \
            locales \
            wget \
            rsync
        locale-gen en_US.UTF-8
        update-locale LANG=en_US.UTF-8
        apt-get clean
        rm -rf /var/lib/apt/lists/*

        cd /opt/programs
        git clone --branch develop https://github.com/bailey-lab/MIPWrangler.git
        cd MIPWrangler
        python3 ./configure.py
        python3 ./setup.py --compfile compfile.mk --outMakefile makefile-common.mk
        make -j 20
        rm -rf external/build
        find . -type f -name "*.a" -delete

        cd /opt/programs
        mv MIPWrangler MIPWrangler_temp
        cd /opt/programs/MIPWrangler_temp
        rsync -amR --include='*/' --include='bin/***' --include='etc/***' --include='lib/***' --include='library/***' --exclude='*' ./ ../MIPWrangler/
        cd /opt/programs
        rm -rf MIPWrangler_temp
    fi
    if [ -f /opt/programs/MIPWrangler.tar.xz ]; then
        apt-get update && apt-get install -yq --no-install-recommends \
            xz-utils
        cd /opt/programs
        ls
        tar -xJvf ./MIPWrangler.tar.xz
    fi

# ----- pixi stage -----
Bootstrap: docker
From: ghcr.io/prefix-dev/pixi:latest
Stage: pixi

%files
    pixi.toml /opt/pixi.toml
    pixi.lock /opt/pixi.lock

%post
    cd /opt
    pixi install --frozen --manifest-path pixi.toml
    export PATH="/opt/.pixi/envs/default/bin:$PATH"
    Rscript -e 'devtools::install_github("OJWatson/McCOILR", ref = "v1.3.1")'
    Rscript -e 'devtools::install_version(package = "rehh", version = "3.2.2", repos = "https://cloud.r-project.org")'
    pixi remove r-devtools

# ----- final stage -----
Bootstrap: docker
From: amd64/ubuntu:22.04
Stage: final

%files from wrangler
    /opt/programs/MIPWrangler /opt/programs/MIPWrangler

%files from pixi
    /opt/.pixi/envs/default /opt/.pixi/envs/default

%post
    apt-get update \
    && apt-get -yq dist-upgrade \
    && apt-get install -yq --no-install-recommends \
    alien \
    bzip2 \
    ca-certificates \
    fonts-dejavu \
    fonts-liberation \
    ghostscript \
    git \
    less \
    libbz2-dev \
    libcurl4-gnutls-dev \
    liblzma-dev \
    libssl-dev \
    libtbb-dev \
    libxext6 \
    libxrender1 \
    libxrender1 \
    libz-dev \
    locales \
    micro \
    nano \
    openjdk-11-jdk \
    openssh-client \
    perl-tk \
    pigz \
    pip \
    rsync \
    software-properties-common \
    sudo \
    tree \
    unzip \
    wget \
    xclip \
    ncdu \
    libnss3 libatk-bridge2.0-0 libcups2 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 libxkbcommon0 libpango-1.0-0 libcairo2 libasound2
    wget -q -O /tmp/google-chrome.deb \
        https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb
    apt-get install -yq --no-install-recommends /tmp/google-chrome.deb
    rm /tmp/google-chrome.deb

    # set environment locale
    locale-gen en_US.UTF-8
    update-locale LANG=en_US.UTF-8

    # install bcl2fastq, if the file is there
    cd /opt/programs
    unzip bcl2fastq2*.zip || true
    alien bcl2fastq2*.rpm || true
    dpkg -i bcl2fastq2*.deb || true

    # install parasight
    cd /opt/programs
    git clone --branch v7.6 https://github.com/bailey-lab/parasight.git
    mkdir -p /opt/bin && mv parasight/parasight.pl /opt/bin/
    rm -rf parasight

    # install basespace cli
    BS_VERSION=1.5.1
    BS_PATH="https://launch.basespace.illumina.com/CLI/${BS_VERSION}/amd64-linux/bs"
    wget $BS_PATH -O /opt/bin/bs

    # add executable flag to executables
    chmod -R +xr /usr/bin
    chmod -R +xr /opt/bin

%environment
    export PATH=/opt/bin:/opt/.pixi/envs/default/bin:/opt/programs/MIPWrangler/bin:$PATH
